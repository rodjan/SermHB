---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const aktuality = (await getCollection('aktuality')).filter((p) => !p.data.draft);
  return aktuality.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.date);
---
<Base title={post.data.title} description={post.data.perex} image={post.data.cover}>
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / <a href="/aktuality">Aktuality</a></div>
      <h1>{post.data.title}</h1>
      <p>{dateStr}</p>
    </div>
  </section>

  <article class="section">
    <div class="container">
      {post.data.cover && <img src={post.data.cover} alt={post.data.title} class="article-cover" />}
      <div class="prose">
        <Content />
      </div>
      <p style="margin-top:2rem"><a href="/aktuality" class="btn btn--outline">← Zpět na aktuality</a></p>
    </div>
  </article>
</Base>

<style>
  .article-cover { width: 100%; max-height: 460px; object-fit: cover; object-position: center 22%; border-radius: var(--radius); margin-bottom: 2rem; box-shadow: var(--shadow); }
</style>
