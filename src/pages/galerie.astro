---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const alba = (await getCollection('galerie'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => new Intl.DateTimeFormat('cs-CZ', { month: 'long', year: 'numeric' }).format(d);
const coverOf = (a: typeof alba[number]) => a.data.cover || a.data.fotky[0]?.obrazek;
---
<Base title="Fotogalerie" description="Fotogalerie ze šermířských tréninků, závodů a akcí oddílu ŠERM Havlíčkův Brod.">
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / Fotogalerie</div>
      <h1>Fotogalerie</h1>
      <p>Momentky z tréninků, závodů a akcí oddílu.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {alba.length > 0 ? (
        <div class="grid grid-3">
          {alba.map((a) => (
            <a class="card album" href={`/galerie/${a.id}`}>
              <div class="card__media">
                {coverOf(a) ? <img src={coverOf(a)} alt={a.data.title} loading="lazy" /> : <div class="album__ph">📷</div>}
              </div>
              <div class="card__body">
                <span class="card__date">{fmt(a.data.date)} · {a.data.fotky.length} fotek</span>
                <h3 class="card__title">{a.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="lead">Zatím tu nejsou žádná fotoalba.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .album { text-decoration: none; color: inherit; }
  .album:hover { text-decoration: none; }
  .album__ph { width: 100%; height: 100%; display: grid; place-items: center; font-size: 3rem; background: var(--bg-soft-2); }
</style>
