---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const alba = (await getCollection('galerie')).filter((a) => !a.data.draft);
  return alba.map((a) => ({ params: { slug: a.id }, props: { a } }));
}

const { a } = Astro.props;
const dateStr = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }).format(a.data.date);
---
<Base title={a.data.title} description={`Fotogalerie – ${a.data.title}`} image={a.data.cover || a.data.fotky[0]?.obrazek}>
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / <a href="/galerie">Fotogalerie</a></div>
      <h1>{a.data.title}</h1>
      <p>{dateStr}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {a.data.fotky.length > 0 ? (
        <div class="gallery-grid">
          {a.data.fotky.map((f) => (
            <a class="gallery-item" href={f.obrazek} target="_blank" rel="noopener">
              <img src={f.obrazek} alt={f.popis || a.data.title} loading="lazy" />
              {f.popis && <span class="gallery-item__caption">{f.popis}</span>}
            </a>
          ))}
        </div>
      ) : (
        <p class="lead">V tomto albu zatím nejsou žádné fotografie.</p>
      )}
      <p style="margin-top:2rem"><a href="/galerie" class="btn btn--outline">← Zpět na fotogalerii</a></p>
    </div>
  </section>
</Base>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.8rem; }
  .gallery-item { position: relative; display: block; border-radius: var(--radius-sm); overflow: hidden; aspect-ratio: 4/3; box-shadow: var(--shadow); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.25s ease; }
  .gallery-item:hover img { transform: scale(1.05); }
  .gallery-item__caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.5rem 0.7rem; font-size: 0.82rem; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,0.7)); }
</style>
