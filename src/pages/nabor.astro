---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('stranky', 'nabor');
const Content = entry ? (await render(entry)).Content : null;
---
<Base title="Nábor" description="Nábor nových členů do šermířského oddílu ŠERM Havlíčkův Brod. Přijďte si vyzkoušet šerm.">
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / Nábor</div>
      <h1>Nábor nových členů</h1>
      <p>Chcete začít se šermem? Provedeme vás prvními kroky.</p>
    </div>
  </section>

  <section class="section">
    <div class="container nabor-grid">
      <div class="prose">
        {Content ? <Content /> : <p>Informace o náboru zatím nebyly vyplněny.</p>}
      </div>
      <aside class="nabor-box">
        <h3>Rychlý kontakt</h3>
        <p>Máte zájem nebo dotaz? Napište nám a domluvíme se na první návštěvě.</p>
        <a href="mailto:info@serm-havlickuv-brod.cz" class="btn btn--primary">Napsat e-mail</a>
        <a href="/kontakt" class="btn btn--outline" style="margin-top:0.6rem">Kontaktní údaje</a>
        <ul class="nabor-facts">
          <li>✔ První tréninky nezávazně</li>
          <li>✔ Vybavení zapůjčíme</li>
          <li>✔ Vhodné pro děti od ~7 let</li>
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .nabor-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2.5rem; align-items: start; }
  .nabor-box { background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.6rem; position: sticky; top: 96px; }
  .nabor-box .btn { display: flex; justify-content: center; }
  .nabor-facts { list-style: none; padding: 0; margin: 1.2rem 0 0; display: flex; flex-direction: column; gap: 0.5rem; color: var(--text-soft); }
  @media (max-width: 820px) { .nabor-grid { grid-template-columns: 1fr; } .nabor-box { position: static; } }
</style>
