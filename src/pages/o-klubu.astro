---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('stranky', 'o-klubu');
const Content = entry ? (await render(entry)).Content : null;
---
<Base title="O klubu" description="O šermířském oddíle ŠERM Havlíčkův Brod – zaměření a hodnoty.">
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / O klubu</div>
      <h1>O klubu</h1>
      <p>Kdo jsme a proč nás šerm baví.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      {Content ? <Content /> : <p>Obsah zatím nebyl vyplněn.</p>}
    </div>
  </section>
</Base>
