---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const treneri = (await getCollection('treneri')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(treneri.map(async (t) => ({ data: t.data, Content: (await render(t)).Content })));
---
<Base title="Trenéři" description="Trenéři šermířského oddílu ŠERM Havlíčkův Brod.">
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / Trenéři</div>
      <h1>Naši trenéři</h1>
      <p>Lidé, kteří vás šermem provedou.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {rendered.length > 0 ? (
        <div class="grid grid-3">
          {rendered.map(({ data, Content }) => (
            <article class="card coach">
              <div class="card__media coach__media">
                {data.photo
                  ? <img src={data.photo} alt={data.name} loading="lazy" />
                  : <div class="coach__placeholder">🤺</div>}
              </div>
              <div class="card__body">
                <h3 class="card__title">{data.name}</h3>
                {data.role && <span class="badge">{data.role}</span>}
                <div class="prose coach__bio"><Content /></div>
                <ul class="coach__contact">
                  {data.email && <li>✉ <a href={`mailto:${data.email}`}>{data.email}</a></li>}
                  {data.phone && <li>📞 <a href={`tel:${data.phone.replace(/\s/g, '')}`}>{data.phone}</a></li>}
                </ul>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="lead">Profily trenérů budou brzy doplněny.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .coach__media { aspect-ratio: 1/1; }
  .coach__placeholder { width: 100%; height: 100%; display: grid; place-items: center; font-size: 3.5rem; background: var(--bg-soft-2); }
  .coach__bio { font-size: 0.95rem; color: var(--text-soft); }
  .coach__bio :global(p) { margin: 0.5rem 0 0; }
  .coach__contact { list-style: none; padding: 0; margin: 0.6rem 0 0; display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; }
</style>
