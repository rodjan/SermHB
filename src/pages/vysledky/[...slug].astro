---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const vysledky = (await getCollection('vysledky')).filter((v) => !v.data.draft);
  return vysledky.map((v) => ({ params: { slug: v.id }, props: { v } }));
}

const { v } = Astro.props;
const { Content } = await render(v);
const dateStr = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }).format(v.data.date);
---
<Base title={v.data.title} image={v.data.cover}>
  <section class="page-head">
    <div class="container">
      <div class="breadcrumb"><a href="/">Úvod</a> / <a href="/vysledky">Výsledky</a></div>
      <h1>{v.data.title}</h1>
      <p>{dateStr}{v.data.misto ? ` · ${v.data.misto}` : ''} · {v.data.zbran}</p>
    </div>
  </section>

  <article class="section">
    <div class="container">
      {v.data.cover && <img src={v.data.cover} alt={v.data.title} class="article-cover" />}
      <div class="prose"><Content /></div>
      <p style="margin-top:2rem"><a href="/vysledky" class="btn btn--outline">← Zpět na výsledky</a></p>
    </div>
  </article>
</Base>

<style>
  .article-cover { width: 100%; max-height: 460px; object-fit: cover; border-radius: var(--radius); margin-bottom: 2rem; box-shadow: var(--shadow); }
</style>
